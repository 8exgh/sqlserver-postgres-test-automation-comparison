<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DbParity.Core/DbParity.Core.csproj" />
  </ItemGroup>

  <!--
    Case and policy files are read from disk at test-discovery time. Copying them
    to the output directory keeps the tests runnable from a published folder as
    well as from the source tree.
  -->
  <ItemGroup>
    <None Include="cases/**/*.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="policy/**/*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
