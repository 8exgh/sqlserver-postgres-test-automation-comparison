# Copy to .env and adjust. SQL Server rejects weak passwords at container start.
# Requires 8+ chars with three of: uppercase, lowercase, digits, symbols.
MSSQL_SA_PASSWORD=Str0ng!Passw0rd

# PostgreSQL conversion target (AWS SCT)
PGUSER=postgres
PGPASSWORD=Str0ng!Passw0rd
PGDATABASE=cdntaxpractice
